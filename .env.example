AWS_REGION=ap-south-1
AWS_PROFILE=personal-main-admin
# Bedrock model for the generative brain. In ap-south-1 use inference-profile IDs:
# Nova Micro (cheap, instant): apac.amazon.nova-micro-v1:0
# Sonnet 4.6 (default): global.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# AWS auth: either a Bedrock API key (fastest for local dev) or access keys
# AWS_BEARER_TOKEN_BEDROCK=...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# Decider 2B local server (strands-decider serve ... --port 8000)
DECIDER_URL=http://localhost:8000
DECIDER_MODEL=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610
# Guardrail confidence policy
DECIDER_MIN_CONFIDENCE=0.6
